<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>enable</Nullable>
    <PackageId>SharpGPU</PackageId>
    <Version>$(StackPackageVersion)</Version>
    <Description>GPU HAL for DirectX 12, Vulkan and Metal.</Description>
    <RepositoryUrl>https://github.com/haolange/SharpGPU</RepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <DefineConstants>$(DefineConstants);SHARPGPU_ENABLE_DX12</DefineConstants>
    <NoWarn>$(NoWarn);CS0162;CS8500;CS9191</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="SharpGen.Runtime" Version="2.4.2-beta" />
    <PackageReference Include="Vortice.Vulkan" Version="3.2.1" />
    <ProjectReference Include="../../third_party/Vortice.Windows/src/Vortice.Direct3D12/Vortice.Direct3D12.csproj" />
    <ProjectReference Include="../../third_party/Vortice.Windows/src/Vortice.DirectML/Vortice.DirectML.csproj" />
    <ProjectReference Include="../../third_party/Vortice.Windows/src/Vortice.DirectStorage/Vortice.DirectStorage.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(StackReferenceMode)' == 'Source'">
    <ProjectReference Include="$(SharpMathRoot)/src/SharpMath/SharpMath.csproj"  StackProduct="SharpMath" StackRoot="$(SharpMathRoot)" />
    <ProjectReference Include="$(SharpMetalRoot)/src/SharpMetal/SharpMetal.csproj"  StackProduct="SharpMetal" StackRoot="$(SharpMetalRoot)" />
  </ItemGroup>
  <ItemGroup Condition="'$(StackReferenceMode)' == 'Package'">
    <PackageReference Include="SharpMath" Version="$(StackPackageVersion)" />
    <PackageReference Include="SharpMetal" Version="$(StackPackageVersion)" />
  </ItemGroup>
  <ItemGroup>
    <None Include="../../docs/SharpGPU/PackageReadme.md" Pack="true" PackagePath="README.md" />
    <None Include="../../LICENSE" Pack="true" PackagePath="/" />
    <EmbeddedResource Include="../../docs/SharpGPU/FeatureMatrix.md">
      <LogicalName>SharpGPU.FeatureMatrix.md</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="../../native/assets.json">
      <LogicalName>SharpGPU.native.assets.json</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
  <ItemGroup>

    <None Include="../../native/assets.json" Pack="true" PackagePath="native/assets.json" />
    <None Include="../../buildTransitive/SharpGPU.targets" Pack="true" PackagePath="buildTransitive/SharpGPU.targets" />
  </ItemGroup>
  <Import Project="../../native/SharpGPU.NativeAssets.props" />
</Project>
