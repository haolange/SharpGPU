<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <Platforms>x64;ARM64</Platforms>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/SharpGPU/SharpGPU.csproj" Condition="'$(StackReferenceMode)' == 'Source'" />
    <ProjectReference Include="$(SharpShaderRoot)/src/SharpShader/SharpShader.csproj"  Condition="'$(StackReferenceMode)' == 'Source'" StackProduct="SharpShader" StackRoot="$(SharpShaderRoot)" />
    <ProjectReference Include="$(SharpShaderRoot)/src/SharpShader/SharpGPU/SharpShader.SharpGPU.csproj"  Condition="'$(StackReferenceMode)' == 'Source'" StackProduct="SharpShader" StackRoot="$(SharpShaderRoot)" />
  </ItemGroup>

  <PropertyGroup><Version>$(StackPackageVersion)</Version><RepositoryUrl>https://github.com/haolange/SharpGPU</RepositoryUrl></PropertyGroup>
  <ItemGroup>
    <PackageReference Include="SharpGPU" Version="$(StackPackageVersion)" Condition="'$(StackReferenceMode)' == 'Package'" />
    <PackageReference Include="SharpShader" Version="$(StackPackageVersion)" Condition="'$(StackReferenceMode)' == 'Package'" />
    <PackageReference Include="SharpShader.SharpGPU" Version="$(StackPackageVersion)" Condition="'$(StackReferenceMode)' == 'Package'" />
  </ItemGroup>
</Project>
