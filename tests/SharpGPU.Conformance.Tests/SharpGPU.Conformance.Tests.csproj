<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <DefineConstants>$(DefineConstants);SHARPGPU_ENABLE_DX12</DefineConstants>
    <Platforms>x64;ARM64</Platforms>
  </PropertyGroup>

  <PropertyGroup Condition="$([MSBuild]::IsOSPlatform('Windows')) or $([MSBuild]::IsOSPlatform('Linux'))">
    <DefineConstants>$(DefineConstants);SHARPGPU_VULKAN_QUALIFICATION_HOST</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="$([MSBuild]::IsOSPlatform('OSX'))">
    <DefineConstants>$(DefineConstants);SHARPGPU_METAL_QUALIFICATION_HOST</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="coverlet.collector" Version="6.0.2">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/SharpGPU/SharpGPU.csproj" Condition="'$(StackReferenceMode)' == 'Source'" />
    <ProjectReference Include="$(SharpShaderRoot)/src/SharpShader/SharpShader.csproj"  Condition="'$(StackReferenceMode)' == 'Source'" StackProduct="SharpShader" StackRoot="$(SharpShaderRoot)" />
    <ProjectReference Include="$(SharpShaderRoot)/src/SharpShader/SharpGPU/SharpShader.SharpGPU.csproj"  Condition="'$(StackReferenceMode)' == 'Source'" StackProduct="SharpShader" StackRoot="$(SharpShaderRoot)" />
    <ProjectReference Include="$(SharpShaderRoot)/src/SharpShader/CSharp/SharpShader.CSharp.csproj"  Condition="'$(StackReferenceMode)' == 'Source'" StackProduct="SharpShader" StackRoot="$(SharpShaderRoot)" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="obj\**\*.cs" />
    <EmbeddedFiles Remove="obj\**\*.cs" />
  </ItemGroup>

  <ItemGroup Condition="Exists('Fixtures/MetalML')">
    <None Include="Fixtures/MetalML/**/*" CopyToOutputDirectory="PreserveNewest" Link="Fixtures/MetalML/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup Condition="Exists('TestData/SharpGPU.MLCook')">
    <None Include="TestData/SharpGPU.MLCook/**/*" CopyToOutputDirectory="PreserveNewest" Link="TestData/SharpGPU.MLCook/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>


  <PropertyGroup><Version>$(StackPackageVersion)</Version><RepositoryUrl>https://github.com/haolange/SharpGPU</RepositoryUrl></PropertyGroup>
  <PropertyGroup Condition="'$(StackReferenceMode)' == 'Source'">
    <DefineConstants>$(DefineConstants);SHARPGPU_SOURCE_LAYOUT_TESTS</DefineConstants>
  </PropertyGroup>
  <ItemGroup Condition="'$(StackReferenceMode)' == 'Package'">
    <!-- These assertions inspect the independent checkout's source layout;
         package mode has an equivalent public-artifact contract below. -->
    <Compile Remove="RhiDomainMirrorContractTests.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="SharpGPU" Version="$(StackPackageVersion)" Condition="'$(StackReferenceMode)' == 'Package'" />
    <PackageReference Include="SharpShader" Version="$(StackPackageVersion)" Condition="'$(StackReferenceMode)' == 'Package'" />
    <PackageReference Include="SharpShader.SharpGPU" Version="$(StackPackageVersion)" Condition="'$(StackReferenceMode)' == 'Package'" />
    <PackageReference Include="SharpShader.CSharp" Version="$(StackPackageVersion)" Condition="'$(StackReferenceMode)' == 'Package'" />
  </ItemGroup>
</Project>
